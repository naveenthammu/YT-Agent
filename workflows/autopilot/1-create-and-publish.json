      "id": "4fd16484-025a-44fb-b217-1511caa9470a",
      "name": "AI: Pick Topic",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "const raw = $json.choices?.[0]?.message?.content ?? '';\nfunction parseJSON(s) {\n  s = String(s).trim().replace(/^```(?:json)?/i, '').replace(/```$/, '').trim();\n  const a = s.indexOf('{'), b = s.lastIndexOf('}');\n  if (a < 0 || b < 0) throw new Error('AI did not return JSON: ' + s.slice(0, 200));\n  return JSON.parse(s.slice(a, b + 1));\n}\nconst t = parseJSON(raw);\nif (!t.topic) throw new Error('AI returned no topic');\nconst norm = s => String(s || '').toLowerCase().replace(/[^a-z0-9]+/g, ' ').trim();\nconst recent = ($('Collect Signals').first().json.recent || []).map(norm);\nif (recent.includes(norm(t.topic))) throw new Error('AI picked a topic we already covered: ' + t.topic);\nreturn [{ json: {\n  topic: String(t.topic).slice(0, 200), angle: t.angle || '', why_now: t.why_now || '',\n  keywords: Array.isArray(t.search_keywords) ? t.search_keywords.slice(0, 8) : [],\n  source: t.source || '', redo_count: 0\n}}];"
      },
      "id": "a88ef878-bf70-47ba-a9a5-07e67a899b53",
      "name": "Parse Topic",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Builds the script-writing prompt. A random style each run keeps videos from looking templated.\nconst cfg = $('Config').first().json;\nconst t = $input.first().json;\nconst styles = String(cfg.video_styles).split('|').map(s => s.trim()).filter(Boolean);\nconst style = styles[Math.floor(Math.random() * styles.length)] || 'Quick explainer';\nconst isShort = cfg.video_format === 'short';\nconst length = isShort ? '110-150 spoken words (45-60 seconds)' : '850-1100 spoken words (6-8 minutes)';\nconst segs = isShort ? '6-9' : '14-22';\nconst redoNote = t.redo_count > 0\n  ? `\\nIMPORTANT: the editor rejected the previous script for this topic. Write a clearly different take (different hook, structure and examples).\\n` : '';\n\nconst user = `Write a ${isShort ? 'YouTube Short' : 'long-form YouTube video'} script.\n\nTOPIC: ${t.topic}\nANGLE / PROMISE: ${t.angle}\nSTYLE FOR THIS VIDEO: ${style}\nNICHE: ${cfg.channel_niche}\nAUDIENCE: ${cfg.audience}\nLANGUAGE: ${cfg.language}\nCREATOR VOICE: ${cfg.creator_notes}\nLENGTH: ${length}, split into ${segs} segments.\n${redoNote}\nRules:\n- First sentence is the hook: a surprising fact, a bold claim you can back up, or a question. No greetings, no \"in this video\".\n- Spoken style: short sentences, simple words, one idea per sentence.\n- Give at least one specific, genuinely useful takeaway the viewer can act on today. Add real insight or opinion, not generic filler.\n- Never invent statistics, quotes, prices or dates. If unsure, say it without a number.\n- Each segment has \"text\" (1-3 sentences, exactly what the narrator says) and \"visual_query\" (2-4 word concrete stock-footage search that can be filmed, e.g. \"person typing laptop\", \"server room lights\", \"city traffic night\"; never abstract words).\n- End with one natural call to action (comment question or subscribe), max one sentence.\n- title: max 70 characters, curiosity + main keyword, honest (no clickbait lies), no ALL CAPS.\n- description: 2-3 short paragraphs using the main keywords naturally, then 3 relevant hashtags${isShort ? ' including #Shorts' : ''}.\n- tags: 8-15 search phrases.\n- thumbnail_text: max 5 punchy words.\n- pinned_comment: a question that invites replies.\n\nReturn JSON only:\n{\"title\": \"...\", \"description\": \"...\", \"tags\": [\"...\"], \"thumbnail_text\": \"...\", \"pinned_comment\": \"...\", \"segments\": [{\"text\": \"...\", \"visual_query\": \"...\"}]}`;\n\nreturn [{ json: { ...t, style, llm_body: {\n  model: cfg.llm_model, temperature: 0.85, response_format: { type: 'json_object' },\n  messages: [\n    { role: 'system', content: 'You are an expert YouTube scriptwriter who writes original, high-retention scripts. Reply with JSON only.' },\n    { role: 'user', content: user }\n  ]\n}}}];"
      },
      "id": "b86a5ca9-3d0e-426d-8841-10197c7b3680",
      "name": "Build Script Prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1760,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.llm_base_url }}/chat/completions",
        "options": {
          "timeout": 240000
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.llm_body) }}"
      },
      "id": "7610466d-9bf6-4441-9f79-906e57c59ce6",
      "name": "AI: Write Script",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1980,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "const cfg = $('Config').first().json;\nconst req = $('Build Script Prompt').last().json;\nconst raw = $json.choices?.[0]?.message?.content ?? '';\nfunction parseJSON(s) {\n  s = String(s).trim().replace(/^```(?:json)?/i, '').replace(/```$/, '').trim();\n  const a = s.indexOf('{'), b = s.lastIndexOf('}');\n  if (a < 0 || b < 0) throw new Error('AI did not return JSON: ' + s.slice(0, 200));\n  return JSON.parse(s.slice(a, b + 1));\n}\nconst s = parseJSON(raw);\nconst isShort = cfg.video_format === 'short';\nconst segments = (Array.isArray(s.segments) ? s.segments : [])\n  .map(x => ({ text: String(x.text || '').trim().slice(0, 1100), visual_query: String(x.visual_query || '').trim().slice(0, 100) }))\n  .filter(x => x.text.length > 0)\n  .slice(0, isShort ? 12 : 40);\nif (segments.length < 3) throw new Error('Script too short: ' + segments.length + ' segments');\nconst words = segments.reduce((n, x) => n + x.text.split(/\\s+/).length, 0);\nif (isShort && words > 190) throw new Error(`Short script too long (${words} words) - would exceed 60s`);\n\nlet title = String(s.title || req.topic).replace(/\\s+/g, ' ').trim().slice(0, 95);\nlet description = String(s.description || '').trim();\nif (isShort && !/#shorts/i.test(description)) description += '\\n\\n#Shorts';\ndescription = (description + '\\n\\nStock footage: Pexels / Pixabay').slice(0, 4900);\n\nconst tags = []; let len = 0;\nfor (const t of (Array.isArray(s.tags) ? s.tags : [])) {\n  const tag = String(t).replace(/[<>,]/g, '').trim();\n  if (!tag || len + tag.length + 1 > 450) continue;\n  tags.push(tag); len += tag.length + 1;\n}\nconst esc = x => String(x || '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');\nreturn [{ json: {\n  topic: req.topic, angle: req.angle, style: req.style, redo_count: req.redo_count || 0,\n  title, description, tags, tags_csv: tags.join(','), thumbnail_text: String(s.thumbnail_text || title).slice(0, 40),\n  pinned_comment: String(s.pinned_comment || ''), word_count: words,\n  title_html: esc(title), topic_html: esc(req.topic), style_html: esc(req.style), description_html: esc(description.slice(0, 2200)),\n  tags_html: esc(tags.join(', ')), pinned_html: esc(s.pinned_comment || ''),\n  render_body: { format: cfg.video_format, voice: cfg.voice, speed: Number(cfg.speed) || 1,\n                 music: String(cfg.music) === 'true', title, thumbnail_text: String(s.thumbnail_text || title).slice(0, 40), segments }\n}}];"
      },
      "id": "068b443d-747b-450c-8daf-2c4b89501b90",

      "id": "1b8ce5e1-819a-409b-b7b7-f1c13ba97528",
      "name": "Past Videos",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        300
      ],
      "onError": "continueRegularOutput",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "// Gather trend signals + our own history, then build the \"pick a topic\" prompt.\nconst cfg = $('Config').first().json;\nconst decode = s => String(s || '')\n  .replace(/<!\\[CDATA\\[|\\]\\]>/g, '')\n  .replace(/&amp;/g, '&').replace(/&quot;/g, '\"').replace(/&#39;|&apos;/g, \"'\")\n  .replace(/&lt;/g, '<').replace(/&gt;/g, '>').trim();\n\n// 1) Google Trends RSS\nconst trends = [];\nconst rss = String($('Google Trends').first().json.data || '');\nfor (const m of rss.matchAll(/<item>([\\s\\S]*?)<\\/item>/g)) {\n  const block = m[1];\n  const tag = t => { const r = block.match(new RegExp('<' + t + '>([\\\\s\\\\S]*?)</' + t + '>')); return r ? decode(r[1]) : ''; };\n  const title = tag('title');\n  if (!title) continue;\n  const news = [...block.matchAll(/<ht:news_item_title>([\\s\\S]*?)<\\/ht:news_item_title>/g)]\n    .map(x => decode(x[1])).slice(0, 2);\n  trends.push(`${title} (${tag('ht:approx_traffic') || '?'} searches)` + (news.length ? ' - news: ' + news.join(' | ') : ''));\n}\n\n// 2) YouTube most-popular in our category\nconst youtube = (($('YouTube Trending').first().json || {}).items || []).map(v =>\n  `${v.snippet?.title} (${Number(v.statistics?.viewCount || 0).toLocaleString('en-US')} views)`);\n\n// 3) Our history: avoid repeats, learn from winners\nconst vids = (($('Past Videos').first().json || {}).videos) || [];\nconst recent = vids.slice(0, 60).map(v => v.topic || v.title).filter(Boolean);\nconst top = vids.filter(v => (v.views || 0) > 0)\n  .sort((a, b) => (b.views || 0) - (a.views || 0)).slice(0, 5)\n  .map(v => `${v.title} - ${v.views} views`);\n\nconst list = (arr, empty) => arr.length ? arr.map(x => '- ' + x).join('\\n') : empty;\nconst user = `CHANNEL NICHE: ${cfg.channel_niche}\nTARGET AUDIENCE: ${cfg.audience}\nLANGUAGE: ${cfg.language}\nVIDEO FORMAT: ${cfg.video_format === 'short' ? 'YouTube Short (under 60 seconds)' : 'long-form video (6-8 minutes)'}\n\nTRENDING GOOGLE SEARCHES (${cfg.trends_geo}, last 24h):\n${list(trends.slice(0, 20), '- (none available today)')}\n\nTRENDING YOUTUBE VIDEOS IN OUR CATEGORY:\n${list(youtube.slice(0, 20), '- (none available today)')}\n\nOUR BEST-PERFORMING VIDEOS (make more like these):\n${list(top, '- (no data yet)')}\n\nTOPICS WE ALREADY COVERED (never repeat these):\n${list(recent, '- (none yet)')}\n\nRules:\n1. Stay inside the niche. Use a trend only if it genuinely connects to the niche; otherwise choose a strong evergreen topic in the niche that people actively search for.\n2. Prefer topics with a clear viewer benefit: save money, save time, avoid a mistake, get a job/skill, understand news that affects them.\n3. Avoid medical, legal or personal-investment advice, tragedies, politics, and real people's private lives.\n4. Never invent facts or numbers.\n\nReturn JSON only:\n{\"topic\": \"...\", \"angle\": \"the specific promise/hook of the video\", \"why_now\": \"...\", \"search_keywords\": [\"...\", \"...\"], \"source\": \"google_trends | youtube_trending | evergreen\"}`;\n\nreturn [{ json: {\n  trends_found: trends.length, youtube_found: youtube.length, recent, top,\n  llm_body: {\n    model: cfg.llm_model, temperature: 0.7, response_format: { type: 'json_object' },\n    messages: [\n      { role: 'system', content: 'You are the content strategist for a YouTube channel. You pick ONE video topic per run that will earn the most views from the target audience while staying inside the niche. Reply with JSON only.' },\n      { role: 'user', content: user }\n    ]\n  }\n}}];"
      },
      "id": "25dc7e4b-8954-4d41-9f9d-b70a30229e34",
      "name": "Collect Signals",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.llm_base_url }}/chat/completions",
        "options": {
          "timeout": 180000

# Copy to .env and fill in. .env is never committed to git - keep ALL secrets there, not in this file.

# ---- Stock footage: set at least one (both are free) ----
# Pexels:  https://www.pexels.com/api/  (key can take a while to arrive)
PEXELS_API_KEY=
# Pixabay: https://pixabay.com/api/docs/  (log in, key is shown instantly on that page)
PIXABAY_API_KEY=

# Any long random string; open the dashboard with ?token=THIS
DASHBOARD_TOKEN=

TZ=Asia/Kolkata
# Rendered videos are deleted after this many days
MEDIA_RETENTION_DAYS=7

# ---- n8n installed on Windows (D:\n8n): the studio is reached on localhost ----
STUDIO_INTERNAL_URL=http://localhost:8000
# Set automatically by start-local.ps1 to this PC's Wi-Fi IP
LOCAL_HOST=localhost

# ---- Only for running n8n in Docker / on a server ----
DOMAIN=yt.example.com
# Generate with:  openssl rand -hex 24
N8N_ENCRYPTION_KEY=
N8N_VERSION=latest
KOKORO_VERSION=latest
